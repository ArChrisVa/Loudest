{
  "name": "loudest",
  "version": "2.1.0",
  "private": true,
  "description": "Finds the moments worth editing in a long stream VOD.",
  "author": "Loudest",
  "license": "FSL-1.1-MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.loudest.app",
    "productName": "Loudest",
    "files": [
      "*.js",
      "index.html",
      "styles.css",
      "icon.ico",
      "models/**",
      "fonts/**",
      "tools/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/{DirectML,dxcompiler}.dll"
    ],
    "asarUnpack": [
      "models/**",
      "fonts/**",
      "tools/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ArChrisVa",
        "repo": "Loudest"
      }
    ],
    "extraFiles": [
      "THIRD-PARTY-NOTICES.txt",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.31.1"
  }
}
